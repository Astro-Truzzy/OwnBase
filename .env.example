# Supabase (required for auth and storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for Paystack webhook (server-only; never expose)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (required for AI Executive Summary generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Paystack (for subscriptions after free trial)
PAYSTACK_SECRET_KEY=sk_live_xxx
# Plan codes from Paystack Dashboard > Plans (create plans there, then paste codes here)
PAYSTACK_PLAN_STARTER=PLN_xxx
PAYSTACK_PLAN_PRO=PLN_xxx
# Optional: per-plan monthly AI summary limits
# STARTER_AI_SUMMARIES_PER_MONTH=20
# PRO_AI_SUMMARIES_PER_MONTH=200

# Canonical app URL (auth OAuth redirects, email confirmation, Paystack callback)
# Production: https://yourapp.com  |  Local: http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://yourapp.com
#
# Supabase → Authentication → URL Configuration must allowlist:
#   {NEXT_PUBLIC_APP_URL}/auth/callback
#   http://localhost:3000/auth/callback
# See docs/AUTH_REDIRECTS.md
