# Supabase (required for auth and storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for Paystack webhook (server-only; never expose)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (required for AI Executive Summary generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Paystack (for subscriptions after free trial)
PAYSTACK_SECRET_KEY=sk_live_xxx
# Plan codes from Paystack Dashboard > Plans (create plans there, then paste codes here)
PAYSTACK_PLAN_STARTER=PLN_xxx
PAYSTACK_PLAN_PRO=PLN_xxx
# Optional: per-plan monthly AI summary limits
# STARTER_AI_SUMMARIES_PER_MONTH=20
# PRO_AI_SUMMARIES_PER_MONTH=200

# Canonical app URL (auth OAuth redirects, email confirmation, Paystack callback)
# Production: https://yourapp.com  |  Local: http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://yourapp.com
#
# Supabase → Authentication → URL Configuration must allowlist:
#   {NEXT_PUBLIC_APP_URL}/auth/callback
#   http://localhost:3000/auth/callback
# See docs/AUTH_REDIRECTS.md

# Optional: local dev only — shared GitHub PAT when OAuth token is unavailable (never set in production)
# GITHUB_TOKEN=ghp_xxx

# Required in production — encrypts GitHub tokens in user_github_tokens (openssl rand -base64 32)
# GITHUB_TOKEN_ENCRYPTION_KEY=

# Rate limiting (recommended for production) — https://upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cron digest route (Bearer token)
# CRON_SECRET=your-random-secret

# Admin dashboard — /admin/login requires both of these
# NEVER prefix either with NEXT_PUBLIC_.
# ADMIN_ALLOWED_EMAILS: comma-separated. Must match the email you type at login.
# ADMIN_PASSWORD: a strong password you choose — stored only in env, never in DB.
# ADMIN_ALLOWED_EMAILS=you@yourdomain.com
# ADMIN_PASSWORD=your-strong-secret-password
